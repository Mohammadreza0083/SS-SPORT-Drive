# =================================================================
# SS-SPORT Drive: environment settings
# Copy to .env (git-ignored) and fill in. Never commit real values.
# Read by: docker compose, the API and workers (DotNetEnv), and web/next.config.ts.
# .NET settings use "__" for nesting (Telegram__BotToken = Telegram:BotToken).
# =================================================================

# --- Runtime environment (local runs) -------------------------------
# Development shows the API docs at /scalar. Servers set this themselves; production hides the docs.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# --- Database (PostgreSQL) ----------------------------------------
# DB_SERVER is "localhost" when you run the API with `dotnet run`; inside Docker the
# compose file points the apps at the "postgres" service instead.
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=ss_sport_drive
DB_USER=ssdrive
DB_PASSWORD=change-me
ConnectionStrings__DefaultConnection=Host=${DB_SERVER};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}

# --- Web front-end <-> API ----------------------------------------
# Where the Next.js server reaches the API.
API_BASE_URL=http://localhost:5080
# Public URL of the web app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# CORS: the only browser origins allowed to call the API (comma-separated). Everything else is refused.
Cors__AllowedOrigins=http://localhost:3000

# --- Local object storage (RustFS, S3-compatible stand-in for R2) --
Storage__ServiceUrl=http://localhost:9000
Storage__AccessKey=ssdrive-local
Storage__SecretKey=change-me
Storage__Bucket=ss-sport-drive
# Signing region; R2 maps us-east-1 to its own "auto". Player photos (T-4b) are stored here.
Storage__Region=us-east-1

# --- Cloudflare R2 (real bucket: backup of the Google Shared Drive) --
R2__ServiceUrl=https://<account-id>.r2.cloudflarestorage.com
R2__Bucket=
R2__AccessKeyId=
R2__SecretAccessKey=

# --- Edge (Cloudflare Worker) -------------------------------------
# HLS token signing key shared with the Worker (wrangler secret HLS_SIGNING_KEY): base64 of 32+ random bytes.
# Generate one with: openssl rand -base64 32. Empty turns HLS token issuing off.
Edge__HlsSigningKey=

# --- Telegram bot -------------------------------------------------
Telegram__BotUsername=
Telegram__BotToken=
# Telegram user ID of the first admin, and their console sign-in email (both needed to create them on their first /start).
Telegram__AdminUserId=
Telegram__AdminEmail=
# How updates arrive: Webhook (VPS) or Polling (local development, no public URL needed).
Telegram__Mode=Webhook
# Secret Telegram sends with every webhook call (1-256 of A-Z a-z 0-9 _ -). Empty = webhook disabled (all calls get 401).
Telegram__WebhookSecret=
# Public HTTPS URL of /telegram/webhook, registered by `dotnet SsSport.Drive.Api.dll telegram-set-webhook`.
Telegram__WebhookUrl=
# Public HTTPS URL of the Mini App (e.g. https://drive.ss-sport.co/miniapp). telegram-set-webhook makes it the bot's
# "Open Drive" menu button. Empty (local development) leaves the menu button alone.
Telegram__MiniAppUrl=
# Optional HTTP proxy for Bot API calls where Telegram needs a VPN, e.g. http://127.0.0.1:10808
# (inside Docker use http://host.docker.internal:10808). Leave empty on the VPS.
Telegram__Proxy=

# --- Email: Resend (OTP primary) ----------------------------------
Email__Resend__ApiKey=
Email__Resend__SenderName=SS-SPORT
Email__Resend__SenderEmail=info@ss-sport.co

# --- Email: Brevo (OTP fallback) ----------------------------------
Email__Brevo__ApiKey=
Email__Brevo__SenderName=SS-SPORT
Email__Brevo__SenderEmail=info@ss-sport.co

# --- Google Drive (service account, read-only) --------------------
# Path to the downloaded JSON key (keep it in secrets/, which is git-ignored).
GoogleDrive__ServiceAccountKeyPath=secrets/service-account.json
# The ID at the end of the Shared Drive URL: drive.google.com/drive/folders/<ID>
GoogleDrive__SharedDriveId=
# Optional HTTP proxy for Google calls where Google needs a VPN, e.g. http://127.0.0.1:10808. Leave empty on the VPS.
GoogleDrive__Proxy=

# --- Cloudflare Turnstile (anti-spam on public forms) -------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
Turnstile__SecretKey=

# --- Email: Google SMTP (all non-OTP mail) ------------------------
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__Username=info@ss-sport.co
# 16-character Google app password, no spaces.
Email__Smtp__Password=
Email__Smtp__SenderName=SS-SPORT
Email__Smtp__SenderEmail=info@ss-sport.co

# --- Host ports for docker compose --------------------------------
API_PORT=5080
WEB_PORT=3000
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
