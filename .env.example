# =================================================================
# SS-SPORT Drive: environment settings
# Copy to .env (git-ignored) and fill in. Never commit real values.
# Read by: docker compose, the API and workers (DotNetEnv), and web/next.config.ts.
# .NET settings use "__" for nesting (Telegram__BotToken = Telegram:BotToken).
# =================================================================

# --- Runtime environment (local runs) -------------------------------
# Development shows the API docs at /scalar. Servers set this themselves; production hides the docs.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# --- Database (PostgreSQL) ----------------------------------------
# DB_SERVER is "localhost" when you run the API with `dotnet run`; inside Docker the
# compose file points the apps at the "postgres" service instead.
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=ss_sport_drive
DB_USER=ssdrive
DB_PASSWORD=change-me
# Least-privilege role the API and workers use inside Docker (row reads/writes only, no schema changes).
# `migrate` creates it and keeps its password in sync. Password: 16+ printable ASCII characters, no spaces.
DB_APP_USER=ssdrive_app
DB_APP_PASSWORD=change-me-app-password
# Local `dotnet run` (including `dotnet run -- migrate`) connects as the owner above.
ConnectionStrings__DefaultConnection=Host=${DB_SERVER};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}
# SQL commands are not logged one by one (D-14). A command that takes at least this long is logged as a Warning with its
# SQL text (never its parameter values). To see every command for a while, set
# Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Information.
Database__SlowQueryThresholdMs=500
# Connection pools (D-15): the API opens at most 40 connections and the workers 20, set in each host's appsettings.json,
# so together they stay under PostgreSQL's 100. Do not set Database__MaxPoolSize here: both hosts read this file.
# Opening a connection (including the wait for a free one) gives up after this many seconds; the API then answers 503.
Database__PoolTimeoutSeconds=5

# --- Web front-end <-> API ----------------------------------------
# Where the Next.js server reaches the API.
API_BASE_URL=http://localhost:5080
# Public URL of the web app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# CORS: the only browser origins allowed to call the API (comma-separated). Everything else is refused.
Cors__AllowedOrigins=http://localhost:3000

# --- Security (decisions §1b) ---------------------------------------
# Reverse proxies allowed to set X-Forwarded-For/-Proto (addresses or CIDR ranges, comma-separated).
# Loopback is always trusted. On the VPS, set the Docker network of the proxy and the web app, e.g. 172.18.0.0/16:
# the web app passes each viewer's address on, so per-address limits count viewers, not the web server.
Security__TrustedProxies=
# Per-client request budgets per minute (429 + Retry-After above them). The webhook and the public link
# endpoints (/links/*: the email gate, L-2) have their own budgets; a signed-in viewer's content reads
# (GET /links/{code}/content and /players/..., V-2b) have a larger one, as a roster page alone loads about 20 photos.
RateLimiting__PermitsPerMinute=300
RateLimiting__WebhookPermitsPerMinute=1800
RateLimiting__LinkPermitsPerMinute=30
RateLimiting__ViewerPermitsPerMinute=240
# The public site (P-8): reads under /public (search, locked pages, photos) share one budget; the two anti-spam writes
# (POST /public/access-code and /public/access-requests) get a very small one.
RateLimiting__PublicPermitsPerMinute=120
RateLimiting__AccessPermitsPerMinute=10

# Sign-in endpoints (/auth/*, A-1 and P-5), per address.
RateLimiting__AuthPermitsPerMinute=10

# --- Public web app address, for emailed links (sign-in, kept forwards) ---
Web__PublicBaseUrl=

# --- Local object storage (RustFS, S3-compatible stand-in for R2) --
Storage__ServiceUrl=http://localhost:9000
Storage__AccessKey=ssdrive-local
Storage__SecretKey=change-me
Storage__Bucket=ss-sport-drive
# Signing region; R2 maps us-east-1 to its own "auto". Player photos (T-4b) are stored here.
Storage__Region=us-east-1
# Read-only rclone backup bucket of the Drive (ssdrivebackup). Ingest reuses its originals by md5 and copies them inside
# storage (I-2); empty turns that off. The app never writes to it.
Storage__BackupBucket=

# --- Ingest: ffmpeg, PDF, QR and cut-out work in the Workers host (Epic 3) --
# ffmpeg and ffprobe are on the PATH in the Workers image; set these only for a local run with other locations.
Media__FfmpegPath=ffmpeg
Media__FfprobePath=ffprobe
# Folder for downloads and encodes; empty uses the system temp folder.
Media__WorkPath=
# Media jobs that run at once (1 or 2; ffmpeg is CPU bound).
Media__Workers=1
# Archive players' media jobs that run at once (0 to 2; M-4). They start only while no team file waits; 0 pauses the archive.
Media__ArchiveWorkers=1
# Person-segmentation ONNX model (u2net_human_seg, Apache-2.0) for background removal (I-7); empty turns it off.
Media__CutoutModelPath=

# --- Cloudflare R2 (real bucket: backup of the Google Shared Drive) --
R2__ServiceUrl=https://<account-id>.r2.cloudflarestorage.com
R2__Bucket=
R2__AccessKeyId=
R2__SecretAccessKey=

# --- Edge (Cloudflare Worker) -------------------------------------
# HLS token signing key shared with the Worker (wrangler secret HLS_SIGNING_KEY): base64 of 32+ random bytes.
# Generate one with: openssl rand -base64 32. Empty turns HLS token issuing off.
Edge__HlsSigningKey=

# --- Viewer email gate (L-2) ---------------------------------------
# Key for the device, session and code hashes: base64 of 32+ random bytes (openssl rand -base64 32).
# Required before /r/{code} links can be opened; changing it signs every viewer out.
Viewer__TokenKey=

# --- Telegram bot -------------------------------------------------
Telegram__BotUsername=
Telegram__BotToken=
# Telegram user ID of the first admin, and their console sign-in email (both needed to create them on their first /start).
Telegram__AdminUserId=
Telegram__AdminEmail=
# How updates arrive: Webhook (VPS) or Polling (local development, no public URL needed).
Telegram__Mode=Webhook
# Secret Telegram sends with every webhook call (1-256 of A-Z a-z 0-9 _ -). Empty = webhook disabled (all calls get 401).
Telegram__WebhookSecret=
# Public HTTPS URL of /telegram/webhook, registered by `dotnet SsSport.Drive.Api.dll telegram-set-webhook`.
Telegram__WebhookUrl=
# Bot notices (progress messages, access answers, folder notices) are sent by Hangfire jobs after the request (T-6c).
# The API runs their Hangfire server on the `notices` queue; false turns it off (the notices then wait in the queue).
BackgroundJobs__RunServer=true
# Bot notice rules (T-8): at most one notice message per team member every ThrottleMinutes (1-1440), and none in
# the quiet hours (HH:mm, local to TimeZone; held notices go out together when they end). Same start and end = no quiet hours.
Notifications__ThrottleMinutes=10
Notifications__QuietHoursStart=23:00
Notifications__QuietHoursEnd=08:00
Notifications__TimeZone=Asia/Tehran
# Public HTTPS URL of the Mini App (e.g. https://drive.ss-sport.co/miniapp). telegram-set-webhook makes it the bot's
# "Open Drive" menu button. Empty (local development) leaves the menu button alone.
Telegram__MiniAppUrl=
# Optional HTTP proxy for Bot API calls where Telegram needs a VPN, e.g. http://127.0.0.1:10808
# (inside Docker use http://host.docker.internal:10808). Leave empty on the VPS.
Telegram__Proxy=

# --- Email: Resend (OTP primary) ----------------------------------
Email__Resend__ApiKey=
Email__Resend__SenderName=SS-SPORT
Email__Resend__SenderEmail=info@ss-sport.co

# --- Email: Brevo (OTP fallback) ----------------------------------
Email__Brevo__ApiKey=
Email__Brevo__SenderName=SS-SPORT
Email__Brevo__SenderEmail=info@ss-sport.co

# Local development without Resend/Brevo keys: write gate code emails as .eml files here instead (e.g. .mail).
# Refused in production.
Email__PickupDirectory=

# --- Google Drive (service account, read-only) --------------------
# Path to the downloaded JSON key (keep it in secrets/, which is git-ignored).
GoogleDrive__ServiceAccountKeyPath=secrets/service-account.json
# The ID at the end of the Shared Drive URL: drive.google.com/drive/folders/<ID>
GoogleDrive__SharedDriveId=
# Optional HTTP proxy for Google calls where Google needs a VPN, e.g. http://127.0.0.1:10808. Leave empty on the VPS.
GoogleDrive__Proxy=

# --- Cloudflare Turnstile (anti-spam on public forms) -------------
# Public site key (built into the web bundle). Cloudflare's always-pass test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key (API only, never logged). Outside production an empty value uses Cloudflare's always-pass test secret
# 1x0000000000000000000000000000000AA. In production an empty value refuses every signed-out access request (fail closed).
Turnstile__SecretKey=

# --- Email: Google SMTP (all non-OTP mail) ------------------------
Email__GoogleSmtp__Host=smtp.gmail.com
Email__GoogleSmtp__Port=587
Email__GoogleSmtp__UserName=info@ss-sport.co
# 16-character Google app password, no spaces.
Email__GoogleSmtp__AppPassword=
Email__GoogleSmtp__SenderName=SS-SPORT
Email__GoogleSmtp__SenderEmail=info@ss-sport.co

# --- Host ports for docker compose --------------------------------
API_PORT=5080
WEB_PORT=3000
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
