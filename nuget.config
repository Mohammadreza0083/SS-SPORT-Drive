<?xml version="1.0" encoding="utf-8"?>
<!-- Repository NuGet settings. Packages and vulnerability audit data both come from nuget.org, so a machine-level
     audit source that serves no vulnerability data (NU1905) cannot silently turn the security audit off. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
