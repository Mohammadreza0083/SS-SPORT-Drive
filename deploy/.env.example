# Local development settings for deploy/docker-compose.yml.
# Copy to deploy/.env (git-ignored) and adjust. These values are for local Docker only:
# never reuse them on staging or production.

# --- PostgreSQL ---------------------------------------------------
POSTGRES_DB=ssdrive
POSTGRES_USER=ssdrive
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# --- Object storage (RustFS, S3-compatible stand-in for Cloudflare R2) ---
STORAGE_ACCESS_KEY=ssdrive-local
STORAGE_SECRET_KEY=change-me-local-secret
STORAGE_BUCKET=ss-sport-drive
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# --- Application ports on the host --------------------------------
API_PORT=8080
WEB_PORT=3000
